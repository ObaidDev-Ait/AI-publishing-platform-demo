datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  rank         String   @default("Gold Publisher")
  earnings     Float    @default(0.0)
  articles     Int      @default(0)
  clicks       Int      @default(0)
  approvalRate Float    @default(0.0)
  avatarUrl    String?
  bio          String?
  website      String?
  joinDate     DateTime @default(now())
}
